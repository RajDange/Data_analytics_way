-- ===== Base (OU-aware) =====
Total Records =
    IF ( ISCROSSFILTERED ( dim_operating_unit ),
         SUM ( dq_rule_run_log_ou[total_count] ),
         SUM ( dq_rule_run_log[total_count] ) )

Failed Records =
    IF ( ISCROSSFILTERED ( dim_operating_unit ),
         SUM ( dq_rule_run_log_ou[failed_count] ),
         SUM ( dq_rule_run_log[failed_count] ) )

Passed Records = [Total Records] - [Failed Records]

DQ Score % = DIVIDE ( [Passed Records], [Total Records] )

DQ Score % (Rule Avg) =
    AVERAGEX ( VALUES ( dq_rule_catalog[rule_id] ), [DQ Score %] )

-- ===== Latest run (cards; ignore the date slicer) =====
Latest Run Date =
    CALCULATE ( MAX ( dq_rule_run_log[run_date] ), REMOVEFILTERS ( dim_date ) )

DQ Score % (Latest) =
    VAR d = [Latest Run Date]
    RETURN CALCULATE ( [DQ Score %], REMOVEFILTERS ( dim_date ), dim_date[date] = d )

Total Records (Latest) =
    VAR d = [Latest Run Date]
    RETURN CALCULATE ( [Total Records], REMOVEFILTERS ( dim_date ), dim_date[date] = d )

Failed Records (Latest) =
    VAR d = [Latest Run Date]
    RETURN CALCULATE ( [Failed Records], REMOVEFILTERS ( dim_date ), dim_date[date] = d )

-- ===== Change vs previous run =====
Previous Run Date =
    VAR d = [Latest Run Date]
    RETURN CALCULATE ( MAX ( dq_rule_run_log[run_date] ), REMOVEFILTERS ( dim_date ),
                       dq_rule_run_log[run_date] < d )

DQ Score % (Previous) =
    VAR p = [Previous Run Date]
    RETURN CALCULATE ( [DQ Score %], REMOVEFILTERS ( dim_date ), dim_date[date] = p )

DQ Score Change (pp) = ( [DQ Score % (Latest)] - [DQ Score % (Previous)] ) * 100

-- ===== Run health / audit =====
Rules Executed =
    COUNTROWS ( dq_rule_run_log )

Rules Errored =
    CALCULATE ( COUNTROWS ( dq_rule_run_log ), dq_rule_run_log[status] = "FAILED" )

Rules Errored (Latest) =
    VAR d = [Latest Run Date]
    RETURN CALCULATE ( [Rules Errored], REMOVEFILTERS ( dim_date ), dim_date[date] = d )

Last Run Status =
    VAR lastStart = CALCULATE ( MAX ( dq_run[start_ts] ), REMOVEFILTERS () )
    RETURN CALCULATE ( MAX ( dq_run[status] ), REMOVEFILTERS (), dq_run[start_ts] = lastStart )

Last Run Time =
    CALCULATE ( MAX ( dq_run[end_ts] ), REMOVEFILTERS () )

-- ===== Current worklist (distinct records: a record can have several rows, one per OU/site) =====
Failing Records (Current) =
    COUNTROWS ( SUMMARIZE ( dq_failed_records_current,
                            dq_failed_records_current[rule_id],
                            dq_failed_records_current[record_key] ) )

Records Failing > 30 Days =
    COUNTROWS ( SUMMARIZE (
        FILTER ( dq_failed_records_current, dq_failed_records_current[days_failing] > 30 ),
        dq_failed_records_current[rule_id], dq_failed_records_current[record_key] ) )
