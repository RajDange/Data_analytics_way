-- ===== Base =====
Total Records  = SUM ( dq_rule_run_log[total_count] )
Failed Records = SUM ( dq_rule_run_log[failed_count] )
Passed Records = SUM ( dq_rule_run_log[passed_count] )
Pass Rate %    = DIVIDE ( [Passed Records], [Total Records] )          -- definition A

Pass Rate % (Rule Avg) =                                                -- definition B
    AVERAGEX ( VALUES ( dq_rule_catalog[rule_id] ), [Pass Rate %] )

-- ===== Latest run (for KPI cards, ignores the date slicer) =====
Latest Run Date =
    CALCULATE ( MAX ( dq_rule_run_log[run_date] ), REMOVEFILTERS ( dim_date ) )

Pass Rate % (Latest) =
    VAR d = [Latest Run Date]
    RETURN CALCULATE ( [Pass Rate %], REMOVEFILTERS ( dim_date ), dq_rule_run_log[run_date] = d )

Failed Records (Latest) =
    VAR d = [Latest Run Date]
    RETURN CALCULATE ( [Failed Records], REMOVEFILTERS ( dim_date ), dq_rule_run_log[run_date] = d )

Total Records (Latest) =
    VAR d = [Latest Run Date]
    RETURN CALCULATE ( [Total Records], REMOVEFILTERS ( dim_date ), dq_rule_run_log[run_date] = d )

-- ===== Change vs previous run =====
Previous Run Date =
    VAR d = [Latest Run Date]
    RETURN CALCULATE ( MAX ( dq_rule_run_log[run_date] ), REMOVEFILTERS ( dim_date ),
                       dq_rule_run_log[run_date] < d )

Pass Rate % (Previous) =
    VAR p = [Previous Run Date]
    RETURN CALCULATE ( [Pass Rate %], REMOVEFILTERS ( dim_date ), dq_rule_run_log[run_date] = p )

Pass Rate Change (pp) = ( [Pass Rate % (Latest)] - [Pass Rate % (Previous)] ) * 100

-- ===== Run health =====
Rules Executed (Latest) =
    VAR d = [Latest Run Date]
    RETURN CALCULATE ( COUNTROWS ( dq_rule_run_log ), REMOVEFILTERS ( dim_date ),
                       dq_rule_run_log[run_date] = d )

Rules Errored (Latest) =
    VAR d = [Latest Run Date]
    RETURN CALCULATE ( COUNTROWS ( dq_rule_run_log ), REMOVEFILTERS ( dim_date ),
                       dq_rule_run_log[run_date] = d, dq_rule_run_log[status] = "FAILED" )

Last Run Status =
    VAR lastRun = CALCULATE ( MAX ( dq_run[start_ts] ), REMOVEFILTERS ( dq_run ) )
    RETURN CALCULATE ( MAX ( dq_run[status] ), REMOVEFILTERS ( dq_run ), dq_run[start_ts] = lastRun )

-- ===== Current worklist =====
Failing Records (Current) = COUNTROWS ( dq_failed_records_current )
Avg Days Failing          = AVERAGE ( dq_failed_records_current[days_failing] )
Records Failing > 30 Days =
    CALCULATE ( COUNTROWS ( dq_failed_records_current ), dq_failed_records_current[days_failing] > 30 )
